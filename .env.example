# Application Environment & Logging
APP_NAME=Financial Fraud Detection Platform
APP_ENV=production
LOG_LEVEL=INFO

# Data Paths & ML Artifacts
DATA_PATH=data/raw/financial_fraud_detection_dataset.csv
INTERIM_DATA_PATH=data/interim
PROCESSED_DATA_PATH=data/processed
MODEL_PATH=models/trained/fraud_model.joblib
PREPROCESSOR_PATH=models/preprocessing/preprocessor.joblib
METADATA_PATH=models/metadata

# Database Configuration (SQLite / PostgreSQL compatible URL)
DATABASE_URL=sqlite:///./database/fraud_detection.db

# Server & Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
API_URL=http://localhost:8000

# Security & CORS Settings
CORS_ORIGINS=*
MAX_BATCH_SIZE=500

# Fraud Risk Scoring Thresholds
HIGH_RISK_THRESHOLD=0.65
MEDIUM_RISK_THRESHOLD=0.35
RISK_THRESHOLD=0.65
